    function circleRectCollide(cx, cy, cr, rect) {
      const closestX = Math.max(rect.x, Math.min(cx, rect.x + rect.w));
      const closestY = Math.max(rect.y, Math.min(cy, rect.y + rect.h));
      const dx = cx - closestX;
      const dy = cy - closestY;
      return dx * dx + dy * dy < cr * cr;
    }

    function resolveCircleObstacles(entity) {
      const r = entity.radius;
      entity.x = Math.max(r + 12, Math.min(WORLD_W - r - 12, entity.x));
      entity.y = Math.max(r + 12, Math.min(WORLD_H - r - 12, entity.y));

      for (const obs of OBSTACLES) {
        const closestX = Math.max(obs.x, Math.min(entity.x, obs.x + obs.w));
        const closestY = Math.max(obs.y, Math.min(entity.y, obs.y + obs.h));
        const dx = entity.x - closestX;
        const dy = entity.y - closestY;
        const distSq = dx * dx + dy * dy;

        if (distSq < r * r) {
          const dist = Math.sqrt(distSq) || 0.001;
          const overlap = r - dist;
          entity.x += (dx / dist) * overlap;
          entity.y += (dy / dist) * overlap;
        }
      }
    }

    function pickSafeSpawn() {
      let best = SPAWN_POINTS[0];
      let bestMinDist = -1;

      for (const pt of SPAWN_POINTS) {
        let minDist = 99999;
        for (const rp of state.remotePlayers.values()) {
          const d = Math.hypot(pt.x - rp.x, pt.y - rp.y);
          if (d < minDist) minDist = d;
        }
        for (const bot of state.bots) {
          const d = Math.hypot(pt.x - bot.x, pt.y - bot.y);
          if (d < minDist) minDist = d;
        }
        if (minDist > bestMinDist) {
          bestMinDist = minDist;
          best = pt;
        }
      }
      return { x: best.x + (Math.random() - 0.5) * 40, y: best.y + (Math.random() - 0.5) * 40 };
    }

