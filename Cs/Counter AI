    // =========================================================================
    // 9. УМНЫЕ ИИ-БОТЫ (АВТОЗАПОЛНЕНИЕ АРЕНЫ ДО 4 УЧАСТНИКОВ)
    // =========================================================================
    function rebalanceBots() {
      const realPlayersCount = 1 + state.remotePlayers.size;
      const desiredBots = Math.max(0, 4 - realPlayersCount);

      while (state.bots.length > desiredBots) {
        state.bots.pop();
      }

      while (state.bots.length < desiredBots) {
        const sp = pickSafeSpawn();
        const usedNames = new Set(state.bots.map((b) => b.name));
        const availableName = BOT_NAMES.find((n) => !usedNames.has(n)) || `Бот_${state.bots.length + 1}`;
        state.bots.push({
          id: "bot-" + Math.random().toString(36).slice(2, 8),
          name: availableName,
          isBot: true,
          x: sp.x,
          y: sp.y,
          radius: 18,
          speed: 205 + Math.random() * 25,
          hp: 100,
          maxHp: 100,
          angle: Math.random() * Math.PI * 2,
          tier: 0,
          kills: 0,
          fireCooldown: 0.5 + Math.random() * 0.6,
          strafeDir: Math.random() < 0.5 ? 1 : -1,
          strafeTimer: 1 + Math.random() * 1.5,
          hitFlash: 0,
          meleeSwing: 0
        });
      }
    }

    function updateBots(dt) {
      // Собираем всех потенциальных целей для ботов
      const targets = [
        {
          id: state.myId,
          name: state.myName,
          x: state.me.x,
          y: state.me.y,
          hp: state.me.hp,
          isMe: true
        }
      ];
      for (const rp of state.remotePlayers.values()) {
        if (rp.hp > 0) targets.push({ id: rp.id, name: rp.name, x: rp.x, y: rp.y, hp: rp.hp, isRemote: true });
      }
      for (const b of state.bots) {
        if (b.hp > 0) targets.push({ id: b.id, name: b.name, x: b.x, y: b.y, hp: b.hp, isBot: true, ref: b });
      }

      for (const bot of state.bots) {
        if (bot.hitFlash > 0) bot.hitFlash = Math.max(0, bot.hitFlash - dt);
        if (bot.meleeSwing > 0) bot.meleeSwing = Math.max(0, bot.meleeSwing - dt);

        // Поиск ближайшей цели
        let nearest = null;
        let minDist = 99999;
        for (const t of targets) {
          if (t.id === bot.id || t.hp <= 0) continue;
          const d = Math.hypot(t.x - bot.x, t.y - bot.y);
          if (d < minDist) {
            minDist = d;
            nearest = t;
          }
        }

        if (!nearest) continue;

        const dx = nearest.x - bot.x;
        const dy = nearest.y - bot.y;
        const dist = Math.hypot(dx, dy) || 1;
        const desiredAngle = Math.atan2(dy, dx);
        bot.angle = desiredAngle;

        bot.strafeTimer -= dt;
        if (bot.strafeTimer <= 0) {
          bot.strafeDir *= -1;
          bot.strafeTimer = 1.1 + Math.random() * 1.6;
        }

        const weapon = WEAPONS[bot.tier];
        const preferredDist = weapon.melee ? 34 : weapon.id === 2 ? 190 : 320;

        let moveX = 0;
        let moveY = 0;
        if (dist > preferredDist + 30) {
          moveX += dx / dist;
          moveY += dy / dist;
        } else if (!weapon.melee && dist < preferredDist - 50) {
          moveX -= dx / dist;
          moveY -= dy / dist;
        }

        // Боковое маневрирование
        moveX += (-dy / dist) * 0.65 * bot.strafeDir;
        moveY += (dx / dist) * 0.65 * bot.strafeDir;

        const mLen = Math.hypot(moveX, moveY) || 1;
        bot.x += (moveX / mLen) * bot.speed * dt;
        bot.y += (moveY / mLen) * bot.speed * dt;
        resolveCircleObstacles(bot);

        // Стрельба бота
        bot.fireCooldown -= dt;
        const maxShootRange = weapon.melee ? 56 : 620;
        if (dist < maxShootRange && bot.fireCooldown <= 0) {
          const aimJitter = (Math.random() - 0.5) * 0.16;
          spawnWeaponProjectiles(bot.x, bot.y, bot.angle + aimJitter, bot.tier, bot.id, bot.name, true);
          bot.fireCooldown = weapon.fireRate * (1.25 + Math.random() * 0.35);
          if (weapon.melee) bot.meleeSwing = 0.22;
        }
      }
    }

    // =========================================================================
    // 10. СТРЕЛЬБА, СНАРЯДЫ, УРОН И ПРОГРЕСС ГОНКИ ВООРУЖЕНИЙ
    // =========================================================================
    function spawnWeaponProjectiles(originX, originY, baseAngle, tierIdx, ownerId, ownerName, canDealDamage) {
      const weapon = WEAPONS[tierIdx] || WEAPONS[0];

      if (weapon.melee) {
        // Удар Золотым Ножом в ближнем бою
        const strikeX = originX + Math.cos(baseAngle) * 32;
        const strikeY = originY + Math.sin(baseAngle) * 32;
        spawnParticles(strikeX, strikeY, "#fbbf24", 12, 180);

        if (canDealDamage) {
          checkMeleeHit(strikeX, strikeY, weapon.radius, weapon.damage, ownerId, ownerName, tierIdx);
        }
        return;
      }

      const muzzle = 24;
      const sx = originX + Math.cos(baseAngle) * muzzle;
      const sy = originY + Math.sin(baseAngle) * muzzle;

      for (let i = 0; i < weapon.pellets; i++) {
        let offset = 0;
        if (weapon.pellets > 1) {
          const frac = i / (weapon.pellets - 1) - 0.5;
          offset = frac * weapon.spread + (Math.random() - 0.5) * 0.04;
        } else {
          offset = (Math.random() - 0.5) * weapon.spread;
        }

        const ang = baseAngle + offset;
        state.bullets.push({
          x: sx,
          y: sy,
          vx: Math.cos(ang) * weapon.speed,
          vy: Math.sin(ang) * weapon.speed,
          radius: weapon.radius,
          damage: weapon.damage,
          color: weapon.color,
          pierce: weapon.pierce,
          explosive: weapon.explosive,
          tier: tierIdx,
          ownerId,
          ownerName,
          canDealDamage,
          hitTargets: new Set(),
          life: 1.4
        });
      }

      spawnParticles(sx, sy, weapon.color, 4, 110);
    }

    function checkMeleeHit(cx, cy, radius, damage, attackerId, attackerName, tierIdx) {
      // Проверка попадания по игроку (если атакует бот)
      if (attackerId !== state.myId && Math.hypot(state.me.x - cx, state.me.y - cy) < radius + state.me.radius) {
        applyDamageToMe(damage, attackerId, attackerName, tierIdx);
      }

      // Проверка попадания по удалённым игрокам (если атакуем мы)
      if (attackerId === state.myId) {
        for (const rp of state.remotePlayers.values()) {
          if (Math.hypot(rp.x - cx, rp.y - cy) < radius + rp.radius) {
            handleAttackerScoredHit(attackerId, attackerName, rp.id, rp.name, damage, tierIdx, rp);
          }
        }
      }

      // Проверка попадания по ботам
      for (const bot of state.bots) {
        if (bot.id === attackerId) continue;
        if (Math.hypot(bot.x - cx, bot.y - cy) < radius + bot.radius) {
          handleAttackerScoredHit(attackerId, attackerName, bot.id, bot.name, damage, tierIdx, bot);
        }
      }
    }

    function applyDamageToMe(damage, attackerId, attackerName, attackerTier) {
      if (state.me.invuln > 0 || state.screen !== "playing") return;

      state.me.hp = Math.max(0, state.me.hp - damage);
      state.screenShake = Math.min(12, state.screenShake + 6);
      sound.playHurt();
      spawnParticles(state.me.x, state.me.y, "#fb7185", 12, 180);
      spawnFloatingText(state.me.x, state.me.y - 24, `-${damage}`, "#fda4af");
      updateHUD();

      if (state.me.hp <= 0) {
        state.me.deaths += 1;
        state.me.streak = 0;

        // Понижение ранга при смерти от Золотого Ножа или респавн
        addKillfeedMessage(attackerName, state.myName, WEAPONS[attackerTier]?.name || "Оружие", attackerTier === 7);

        // Респавн игрока
        const sp = pickSafeSpawn();
        state.me.x = sp.x;
        state.me.y = sp.y;
        state.me.hp = 100;
        state.me.invuln = 1.6;
        showToast("ВОЗРОЖДЕНИЕ", "Щиты восстановлены!");
        syncMyStateToCloud(true);
        updateHUD();
      }
    }

    function handleAttackerScoredHit(attackerId, attackerName, targetId, targetName, damage, tierIdx, targetObj) {
      targetObj.hitFlash = 0.09;
      spawnFloatingText(targetObj.x, targetObj.y - 24, `-${damage}`, "#fde047");

      // Если мы попали по удалённому онлайн-игроку — отправляем событие урона по сети
      if (attackerId === state.myId && !targetObj.isBot) {
        publishEvent({
          type: "hit",
          targetId,
          senderName: state.myName,
          damage,
          tier: tierIdx
        });
      }

      // Для ботов (или визуального прогноза) уменьшаем HP локально
      if (targetObj.isBot) {
        targetObj.hp -= damage;
        if (targetObj.hp <= 0) {
          sound.playHit(true);
          spawnParticles(targetObj.x, targetObj.y, "#fb7185", 22, 230);

          // Начисляем убийство атакующему (нам или другому боту)
          if (attackerId === state.myId) {
            onMyKillAchieved(targetObj.name, tierIdx);
          } else {
            const killerBot = state.bots.find((b) => b.id === attackerId);
            if (killerBot) {
              killerBot.kills += 1;
              addKillfeedMessage(killerBot.name, targetObj.name, WEAPONS[tierIdx].name, tierIdx === 7);
              if (tierIdx === 7) {
                triggerMatchVictory(killerBot.name);
                return;
              }
              killerBot.tier = Math.min(WEAPONS.length - 1, killerBot.tier + 1);
            }
          }

          // Респавн бота
          const sp = pickSafeSpawn();
          targetObj.x = sp.x;
          targetObj.y = sp.y;
          targetObj.hp = 100;
        } else if (attackerId === state.myId) {
          sound.playHit(false);
        }
      } else if (attackerId === state.myId) {
        // Локальный прогноз убийства удалённого игрока
        targetObj.hp = Math.max(0, targetObj.hp - damage);
        if (targetObj.hp <= 0) {
          sound.playHit(true);
          spawnParticles(targetObj.x, targetObj.y, "#38bdf8", 24, 240);
          onMyKillAchieved(targetObj.name, tierIdx);
          targetObj.hp = 100;
        } else {
          sound.playHit(false);
        }
      }
    }

    function onMyKillAchieved(victimName, usedTierIdx) {
      state.me.kills += 1;
      state.me.streak += 1;
      state.me.hp = Math.min(100, state.me.hp + 25); // Бонус +25 брони за фраг

      const usedWeapon = WEAPONS[usedTierIdx] || WEAPONS[state.me.tier];
      const isGoldenFinish = usedTierIdx === WEAPONS.length - 1;

      addKillfeedMessage(state.myName, victimName, usedWeapon.name, isGoldenFinish);
      publishEvent({
        type: "kill",
        senderName: state.myName,
        victimName,
        tier: usedTierIdx
      });

      if (isGoldenFinish) {
        incrementWins();
        publishEvent({
          type: "win",
          winnerName: state.myName
        });
        triggerMatchVictory(state.myName);
        return;
      }

      // Повышаем ранг оружия!
      if (state.me.tier < WEAPONS.length - 1) {
        state.me.tier += 1;
        const nextW = WEAPONS[state.me.tier];
        sound.playRankUp();
        showToast(`РАНГ ${state.me.tier + 1} ИЗ ${WEAPONS.length}`, nextW.name);
        spawnParticles(state.me.x, state.me.y, nextW.color, 24, 210);
      }

      syncMyStateToCloud(true);
      updateHUD();
    }

    function triggerMatchVictory(winnerName) {
      if (state.screen === "victory") return;
      state.screen = "victory";
      clearTouchControls();

      ui.hudTop.classList.add("hidden");
      ui.touchHints.classList.add("hidden");
      ui.victoryScreen.classList.remove("hidden");
      ui.victoryWinnerName.textContent = `ПОБЕДИТЕЛЬ: ${winnerName.toUpperCase()}`;

      // Формируем итоговую таблицу
      const participants = getAllParticipantsSorted();
      ui.victoryScoreboard.innerHTML = "";
      participants.forEach((p, idx) => {
        const row = document.createElement("div");
        row.className = `flex items-center justify-between px-3 py-2 rounded-xl text-xs font-bold ${
          p.isMe ? "bg-cyan-500/20 border border-cyan-400/50 text-white" : "bg-slate-900 text-slate-300"
        }`;
        row.innerHTML = `
          <div class="flex items-center gap-2 truncate">
            <span class="text-amber-400 font-black">#${idx + 1}</span>
            <span class="truncate">${escapeHtml(p.name)}</span>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <span class="text-slate-400">Фраги: <strong class="text-white">${p.kills}</strong></span>
            <span class="text-cyan-300">${WEAPONS[p.tier]?.name || "Пистолет"}</span>
          </div>
        `;
        ui.victoryScoreboard.appendChild(row);
      });
    }

    function triggerExplosion(x, y, radius, damage, ownerId, ownerName, tierIdx) {
      spawnParticles(x, y, "#fb7185", 26, 260);
      spawnParticles(x, y, "#fbbf24", 16, 180);
      if (ownerId === state.myId) {
        state.screenShake = Math.min(12, state.screenShake + 7);
      }

      if (ownerId !== state.myId && Math.hypot(state.me.x - x, state.me.y - y) < radius + state.me.radius) {
        applyDamageToMe(Math.round(damage * 0.75), ownerId, ownerName, tierIdx);
      }

      if (ownerId === state.myId) {
        for (const rp of state.remotePlayers.values()) {
          if (Math.hypot(rp.x - x, rp.y - y) < radius + rp.radius) {
            handleAttackerScoredHit(ownerId, ownerName, rp.id, rp.name, damage, tierIdx, rp);
          }
        }
      }

      for (const bot of state.bots) {
        if (bot.id === ownerId) continue;
        if (Math.hypot(bot.x - x, bot.y - y) < radius + bot.radius) {
          handleAttackerScoredHit(ownerId, ownerName, bot.id, bot.name, damage, tierIdx, bot);
        }
      }
    }

    // =========================================================================
    // 11. ЧАСТИЦЫ, ВСПЛЫВАЮЩИЙ ТЕКСТ И HUD
    // =========================================================================
    function spawnParticles(x, y, color, count, maxSpd) {
      for (let i = 0; i < count; i++) {
        const a = Math.random() * Math.PI * 2;
        const s = 30 + Math.random() * maxSpd;
        const life = 0.2 + Math.random() * 0.26;
        state.particles.push({
          x,
          y,
          vx: Math.cos(a) * s,
          vy: Math.sin(a) * s,
          r: 2 + Math.random() * 3,
          color,
          life,
          maxLife: life
        });
      }
    }

    function spawnFloatingText(x, y, text, color) {
      state.floatingTexts.push({
        x,
        y,
        text,
        color,
        life: 0.75,
        maxLife: 0.75
      });
    }

    function getAllParticipantsSorted() {
      const list = [
        {
          id: state.myId,
          name: state.myName,
          tier: state.me.tier,
          kills: state.me.kills,
          isMe: true
        }
      ];

      for (const rp of state.remotePlayers.values()) {
        list.push({
          id: rp.id,
          name: rp.name,
          tier: rp.tier,
          kills: rp.kills,
          isMe: false
        });
      }

      for (const bot of state.bots) {
        list.push({
          id: bot.id,
          name: `${bot.name} [ИИ]`,
          tier: bot.tier,
          kills: bot.kills,
          isMe: false
        });
      }

      list.sort((a, b) => b.tier - a.tier || b.kills - a.kills);
      return list;
    }

    function updateHUD() {
      const hpPct = Math.max(0, Math.min(100, state.me.hp));
      ui.hudHpText.textContent = Math.ceil(hpPct);
      ui.hudHpBar.style.width = `${hpPct}%`;

      ui.hudRoomCode.textContent = state.roomCode;
      ui.hudOnlineCount.textContent = 1 + state.remotePlayers.size;

      if (state.me.streak >= 2) {
        ui.hudStreak.classList.remove("hidden");
        ui.hudStreakVal.textContent = state.me.streak;
      } else {
        ui.hudStreak.classList.add("hidden");
      }

      const w = WEAPONS[state.me.tier] || WEAPONS[0];
      ui.hudTierNum.textContent = state.me.tier + 1;
      ui.hudTierMax.textContent = WEAPONS.length;
      ui.hudWeaponName.textContent = w.name;
      ui.hudWeaponName.style.color = w.color;
      ui.hudTierBar.style.width = `${((state.me.tier + 1) / WEAPONS.length) * 100}%`;

      if (state.me.tier === WEAPONS.length - 1) {
        ui.hudTierHint.textContent = "ФИНАЛ! Добейте врага ножом!";
        ui.hudTierHint.className = "text-[10px] text-amber-300 mt-1 font-extrabold truncate max-w-full";
      } else {
        const nextW = WEAPONS[state.me.tier + 1];
        ui.hudTierHint.textContent = `Далее: ${nextW.name}`;
        ui.hudTierHint.className = "text-[10px] text-slate-400 mt-1 font-semibold truncate max-w-full";
      }

      // Обновление мини-лидерборда
      const sorted = getAllParticipantsSorted().slice(0, 5);
      ui.leaderboardList.innerHTML = "";
      for (const item of sorted) {
        const row = document.createElement("div");
        row.className = `flex items-center justify-between gap-1 px-1.5 py-0.5 rounded ${
          item.isMe ? "bg-cyan-500/20 text-cyan-200 font-extrabold" : "text-slate-300 font-semibold"
        }`;
        row.innerHTML = `<span class="truncate">${escapeHtml(item.name)}</span><span class="text-amber-300 font-black shrink-0">${item.tier + 1}/8</span>`;
        ui.leaderboardList.appendChild(row);
      }
    }

    // =========================================================================
    // 12. УПРАВЛЕНИЕ (ТАЧ-ДЖОЙСТИКИ + КЛАВИАТУРА/МЫШЬ)
    // =========================================================================
    const STICK_RADIUS = 45;

    function clearTouchControls() {
      state.moveTouchId = null;
      state.moveVec = { x: 0, y: 0 };
      ui.moveBase.classList.add("hidden");
      ui.moveKnob.classList.add("hidden");

      state.aimTouchId = null;
      state.aimActive = false;
      ui.aimBase.classList.add("hidden");
      ui.aimKnob.classList.add("hidden");
    }

    function positionStick(baseEl, knobEl, ox, oy, dx, dy) {
      const dist = Math.hypot(dx, dy);
      const clamped = Math.min(STICK_RADIUS, dist);
      const ang = dist > 0.001 ? Math.atan2(dy, dx) : 0;
      baseEl.style.left = `${ox}px`;
      baseEl.style.top = `${oy}px`;
      knobEl.style.left = `${ox + Math.cos(ang) * clamped}px`;
      knobEl.style.top = `${oy + Math.sin(ang) * clamped}px`;
    }

    canvas.addEventListener(
      "touchstart",
      (e) => {
        if (state.screen !== "playing") return;
        e.preventDefault();
        sound.ensure();
        if (!state.hintsDismissed) {
          state.hintsDismissed = true;
          ui.touchHints.classList.add("hidden");
        }

        for (let i = 0; i < e.changedTouches.length; i++) {
          const t = e.changedTouches[i];
          if (t.clientX < state.width * 0.5 && state.moveTouchId === null) {
            state.moveTouchId = t.identifier;
            state.moveOrigin = { x: t.clientX, y: t.clientY };
            state.moveVec = { x: 0, y: 0 };
            ui.moveBase.classList.remove("hidden");
            ui.moveKnob.classList.remove("hidden");
            positionStick(ui.moveBase, ui.moveKnob, t.clientX, t.clientY, 0, 0);
          } else if (state.aimTouchId === null) {
            state.aimTouchId = t.identifier;
            state.aimOrigin = { x: t.clientX, y: t.clientY };
            state.aimActive = true;
            ui.aimBase.classList.remove("hidden");
            ui.aimKnob.classList.remove("hidden");
            positionStick(ui.aimBase, ui.aimKnob, t.clientX, t.clientY, 0, 0);
          }
        }
      },
      { passive: false }
    );

    canvas.addEventListener(
      "touchmove",
      (e) => {
        if (state.screen !== "playing") return;
        e.preventDefault();

        for (let i = 0; i < e.changedTouches.length; i++) {
          const t = e.changedTouches[i];
          if (t.identifier === state.moveTouchId) {
            const dx = t.clientX - state.moveOrigin.x;
            const dy = t.clientY - state.moveOrigin.y;
            const dist = Math.hypot(dx, dy);
            const norm = dist > 6 ? Math.min(1, dist / STICK_RADIUS) : 0;
            const ang = Math.atan2(dy, dx);
            state.moveVec.x = Math.cos(ang) * norm;
            state.moveVec.y = Math.sin(ang) * norm;
            positionStick(ui.moveBase, ui.moveKnob, state.moveOrigin.x, state.moveOrigin.y, dx, dy);
          } else if (t.identifier === state.aimTouchId) {
            const dx = t.clientX - state.aimOrigin.x;
            const dy = t.clientY - state.aimOrigin.y;
            positionStick(ui.aimBase, ui.aimKnob, state.aimOrigin.x, state.aimOrigin.y, dx, dy);
            if (Math.hypot(dx, dy) > 6) {
              state.me.angle = Math.atan2(dy, dx);
            }
            state.aimActive = true;
          }
        }
      },
      { passive: false }
    );

    function onTouchEnd(e) {
      for (let i = 0; i < e.changedTouches.length; i++) {
        const t = e.changedTouches[i];
        if (t.identifier === state.moveTouchId) {
          state.moveTouchId = null;
          state.moveVec = { x: 0, y: 0 };
          ui.moveBase.classList.add("hidden");
          ui.moveKnob.classList.add("hidden");
        } else if (t.identifier === state.aimTouchId) {
          state.aimTouchId = null;
          state.aimActive = false;
          ui.aimBase.classList.add("hidden");
          ui.aimKnob.classList.add("hidden");
        }
      }
    }

    canvas.addEventListener("touchend", onTouchEnd, { passive: false });
    canvas.addEventListener("touchcancel", onTouchEnd, { passive: false });

    window.addEventListener("keydown", (e) => {
      state.keys.add(e.code);
    });
    window.addEventListener("keyup", (e) => {
      state.keys.delete(e.code);
    });

    canvas.addEventListener("mousemove", (e) => {
      const rect = canvas.getBoundingClientRect();
      state.mouseScreen.x = e.clientX - rect.left;
      state.mouseScreen.y = e.clientY - rect.top;
    });

    canvas.addEventListener("mousedown", (e) => {
      if (state.screen !== "playing" || e.button !== 0) return;
      sound.ensure();
      state.mouseDown = true;
    });

    window.addEventListener("mouseup", () => {
      state.mouseDown = false;
    });

    // =========================================================================
    // 13. СИМУЛЯЦИЯ КАДРА
    // =========================================================================
    function getCameraOffset() {
      const camX = Math.max(0, Math.min(Math.max(0, WORLD_W - state.width), state.me.x - state.width * 0.5));
      const camY = Math.max(0, Math.min(Math.max(0, WORLD_H - state.height), state.me.y - state.height * 0.5));
      // Если экран шире арены — центрируем арену
      const offsetX = state.width > WORLD_W ? (state.width - WORLD_W) * 0.5 : -camX;
      const offsetY = state.height > WORLD_H ? (state.height - WORLD_H) * 0.5 : -camY;
      return { offsetX, offsetY };
    }

    function updateSimulation(dt) {
      if (state.screenShake > 0) {
        state.screenShake = Math.max(0, state.screenShake - dt * 26);
      }

      if (state.me.invuln > 0) {
        state.me.invuln = Math.max(0, state.me.invuln - dt);
      }

      if (state.me.meleeSwing > 0) {
        state.me.meleeSwing = Math.max(0, state.me.meleeSwing - dt);
      }

      // Движение игрока
      let mx = state.moveVec.x;
      let my = state.moveVec.y;
      let kx = 0;
      let ky = 0;
      if (state.keys.has("KeyA") || state.keys.has("ArrowLeft")) kx -= 1;
      if (state.keys.has("KeyD") || state.keys.has("ArrowRight")) kx += 1;
      if (state.keys.has("KeyW") || state.keys.has("ArrowUp")) ky -= 1;
      if (state.keys.has("KeyS") || state.keys.has("ArrowDown")) ky += 1;
      if (kx !== 0 || ky !== 0) {
        const len = Math.hypot(kx, ky);
        mx = kx / len;
        my = ky / len;
      }

      state.me.x += mx * state.me.speed * dt;
      state.me.y += my * state.me.speed * dt;
      resolveCircleObstacles(state.me);

      // Прицеливание мышью (если не активен правый тач-джойстик)
      if (state.aimTouchId === null && (state.mouseDown || state.autoFire || kx !== 0 || ky !== 0 || !("ontouchstart" in window))) {
        if (!("ontouchstart" in window) || state.mouseDown) {
          const { offsetX, offsetY } = getCameraOffset();
          const worldMouseX = state.mouseScreen.x - offsetX;
          const worldMouseY = state.mouseScreen.y - offsetY;
          state.me.angle = Math.atan2(worldMouseY - state.me.y, worldMouseX - state.me.x);
        }
      }

      // Стрельба игрока
      state.me.fireCooldown = Math.max(0, state.me.fireCooldown - dt);
      const wantsShoot = state.aimActive || state.mouseDown || state.autoFire || state.keys.has("Space");
      if (wantsShoot && state.me.fireCooldown <= 0) {
        const w = WEAPONS[state.me.tier] || WEAPONS[0];
        spawnWeaponProjectiles(state.me.x, state.me.y, state.me.angle, state.me.tier, state.myId, state.myName, true);
        sound.playWeapon(state.me.tier);
        state.me.fireCooldown = w.fireRate;
        if (w.melee) state.me.meleeSwing = 0.22;

        publishEvent({
          type: "shoot",
          senderName: state.myName,
          x: Math.round(state.me.x),
          y: Math.round(state.me.y),
          angle: Number(state.me.angle.toFixed(2)),
          tier: state.me.tier
        });
      }

      // Плавная интерполяция удалённых игроков
      for (const rp of state.remotePlayers.values()) {
        rp.x += (rp.targetX - rp.x) * Math.min(1, dt * 14);
        rp.y += (rp.targetY - rp.y) * Math.min(1, dt * 14);
        rp.angle = rp.targetAngle;
        if (rp.hitFlash > 0) rp.hitFlash = Math.max(0, rp.hitFlash - dt);
      }

      // Обновление ИИ-ботов
      updateBots(dt);

      // Обновление снарядов
      for (let i = state.bullets.length - 1; i >= 0; i--) {
        const b = state.bullets[i];
        b.x += b.vx * dt;
        b.y += b.vy * dt;
        b.life -= dt;

        // Границы арены
        if (b.x < 0 || b.x > WORLD_W || b.y < 0 || b.y > WORLD_H || b.life <= 0) {
          if (b.explosive > 0 && b.life > 0) {
            triggerExplosion(b.x, b.y, b.explosive, b.damage, b.ownerId, b.ownerName, b.tier);
          }
          state.bullets.splice(i, 1);
          continue;
        }

        // Столкновение со стенами
        let hitWall = false;
        for (const obs of OBSTACLES) {
          if (circleRectCollide(b.x, b.y, b.radius, obs)) {
            hitWall = true;
            break;
          }
        }
        if (hitWall) {
          spawnParticles(b.x, b.y, b.color, 6, 120);
          if (b.explosive > 0) {
            triggerExplosion(b.x, b.y, b.explosive, b.damage, b.ownerId, b.ownerName, b.tier);
          }
          state.bullets.splice(i, 1);
          continue;
        }

        // Проверка попаданий по участникам
        let consumed = false;

        // 1. Попадание по нашему игроку (от ботов; от онлайн-игроков урон приходит через событие 'hit')
        if (b.canDealDamage && b.ownerId !== state.myId && !b.hitTargets.has(state.myId)) {
          if (Math.hypot(b.x - state.me.x, b.y - state.me.y) < b.radius + state.me.radius) {
            b.hitTargets.add(state.myId);
            if (b.explosive > 0) {
              triggerExplosion(b.x, b.y, b.explosive, b.damage, b.ownerId, b.ownerName, b.tier);
              consumed = true;
            } else {
              applyDamageToMe(b.damage, b.ownerId, b.ownerName, b.tier);
              if (b.pierce > 0) b.pierce -= 1;
              else consumed = true;
            }
          }
        }

        // 2. Попадание по удалённым онлайн-игрокам
        if (!consumed && b.canDealDamage && b.ownerId === state.myId) {
          for (const rp of state.remotePlayers.values()) {
            if (b.hitTargets.has(rp.id)) continue;
            if (Math.hypot(b.x - rp.x, b.y - rp.y) < b.radius + rp.radius) {
              b.hitTargets.add(rp.id);
              spawnParticles(b.x, b.y, b.color, 6, 140);
              if (b.explosive > 0) {
                triggerExplosion(b.x, b.y, b.explosive, b.damage, b.ownerId, b.ownerName, b.tier);
                consumed = true;
                break;
              } else {
                handleAttackerScoredHit(b.ownerId, b.ownerName, rp.id, rp.name, b.damage, b.tier, rp);
                if (b.pierce > 0) b.pierce -= 1;
                else {
                  consumed = true;
                  break;
                }
              }
            }
          }
        }

        // 3. Попадание по ИИ-ботам
        if (!consumed && b.canDealDamage) {
          for (const bot of state.bots) {
            if (bot.id === b.ownerId || b.hitTargets.has(bot.id)) continue;
            if (Math.hypot(b.x - bot.x, b.y - bot.y) < b.radius + bot.radius) {
              b.hitTargets.add(bot.id);
              spawnParticles(b.x, b.y, b.color, 6, 140);
              if (b.explosive > 0) {
                triggerExplosion(b.x, b.y, b.explosive, b.damage, b.ownerId, b.ownerName, b.tier);
                consumed = true;
                break;
              } else {
                handleAttackerScoredHit(b.ownerId, b.ownerName, bot.id, bot.name, b.damage, b.tier, bot);
                if (b.pierce > 0) b.pierce -= 1;
                else {
                  consumed = true;
                  break;
                }
              }
            }
          }
        }

        if (consumed) {
          state.bullets.splice(i, 1);
        }
      }

      // Частицы и всплывающий текст
      for (let i = state.particles.length - 1; i >= 0; i--) {
        const p = state.particles[i];
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.vx *= 0.94;
        p.vy *= 0.94;
        p.life -= dt;
        if (p.life <= 0) state.particles.splice(i, 1);
      }

      for (let i = state.floatingTexts.length - 1; i >= 0; i--) {
        const ft = state.floatingTexts[i];
        ft.y -= 38 * dt;
        ft.life -= dt;
        if (ft.life <= 0) state.floatingTexts.splice(i, 1);
      }

      // Периодическая синхронизация позиции с облаком (~12 раз/сек)
      state.syncTimer += dt;
      if (state.syncTimer >= 0.085) {
        state.syncTimer = 0;
        syncMyStateToCloud();
      }
    }

    // =========================================================================
    // 14. ОТРИСОВКА КИБЕР-АРЕНЫ
    // =========================================================================
    function drawFighter(fighter, isMe, isBot) {
      const weapon = WEAPONS[fighter.tier] || WEAPONS[0];
      const blink = isMe && state.me.invuln > 0 && Math.floor(state.me.invuln * 18) % 2 === 0;
      if (blink) return;

      ctx.save();
      ctx.translate(fighter.x, fighter.y);

      // Тень
      ctx.fillStyle = "rgba(0, 0, 0, 0.35)";
      ctx.beginPath();
      ctx.arc(3, 5, fighter.radius, 0, Math.PI * 2);
      ctx.fill();

      // Оружие или дуга Золотого Ножа
      ctx.save();
      ctx.rotate(fighter.angle);
      if (weapon.melee) {
        // Золотой клинок
        ctx.fillStyle = "#fbbf24";
        ctx.beginPath();
        ctx.moveTo(12, -4);
        ctx.lineTo(34, 0);
        ctx.lineTo(12, 4);
        ctx.closePath();
        ctx.fill();

        if (fighter.meleeSwing > 0) {
          ctx.strokeStyle = "rgba(251, 191, 36, 0.7)";
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.arc(10, 0, 34, -0.9, 0.9);
          ctx.stroke();
        }
      } else {
        ctx.fillStyle = weapon.color;
        ctx.beginPath();
        ctx.roundRect(6, -4.5, fighter.radius + 10, 9, 4);
        ctx.fill();
      }
      ctx.restore();

      // Корпус бойца
      ctx.fillStyle = fighter.hitFlash > 0 ? "#ffffff" : isMe ? "#0284c7" : isBot ? "#dc2626" : "#7c3aed";
      ctx.strokeStyle = isMe ? "#e0f2fe" : isBot ? "#fecaca" : "#ddd6fe";
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.arc(0, 0, fighter.radius, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      // Индикатор ранга в центре
      ctx.fillStyle = weapon.color;
      ctx.beginPath();
      ctx.arc(0, 0, 6.5, 0, Math.PI * 2);
      ctx.fill();

      // Имя и полоска здоровья над головой
      const label = isBot ? `${fighter.name} [ИИ]` : fighter.name;
      ctx.font = "800 12px Inter, sans-serif";
      ctx.textAlign = "center";
      ctx.fillStyle = "#060913";
      ctx.fillText(label, 1, -fighter.radius - 15);
      ctx.fillStyle = isMe ? "#38bdf8" : "#f8fafc";
      ctx.fillText(label, 0, -fighter.radius - 16);

      const barW = 42;
      const barH = 4.5;
      const hpPct = Math.max(0, Math.min(1, (fighter.hp ?? 100) / 100));
      ctx.fillStyle = "rgba(15, 23, 42, 0.9)";
      ctx.fillRect(-barW * 0.5, -fighter.radius - 11, barW, barH);
      ctx.fillStyle = isMe ? "#34d399" : "#fb7185";
      ctx.fillRect(-barW * 0.5, -fighter.radius - 11, barW * hpPct, barH);

      ctx.restore();
    }

    function renderScene() {
      ctx.clearRect(0, 0, state.width, state.height);

      ctx.save();
      if (state.screenShake > 0.2) {
        ctx.translate((Math.random() - 0.5) * state.screenShake, (Math.random() - 0.5) * state.screenShake);
      }

      const { offsetX, offsetY } = getCameraOffset();
      ctx.translate(offsetX, offsetY);

      // Пол арены и тактическая сетка
      ctx.fillStyle = "#0b1120";
      ctx.fillRect(0, 0, WORLD_W, WORLD_H);

      ctx.strokeStyle = "rgba(56, 189, 248, 0.06)";
      ctx.lineWidth = 1;
      const grid = 64;
      ctx.beginPath();
      for (let x = 0; x <= WORLD_W; x += grid) {
        ctx.moveTo(x, 0);
        ctx.lineTo(x, WORLD_H);
      }
      for (let y = 0; y <= WORLD_H; y += grid) {
        ctx.moveTo(0, y);
        ctx.lineTo(WORLD_W, y);
      }
      ctx.stroke();

      // Периметр арены
      ctx.strokeStyle = "#38bdf8";
      ctx.lineWidth = 4;
      ctx.strokeRect(2, 2, WORLD_W - 4, WORLD_H - 4);

      // Центральная зона
      ctx.strokeStyle = "rgba(56, 189, 248, 0.14)";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(WORLD_W * 0.5, WORLD_H * 0.5, 190, 0, Math.PI * 2);
      ctx.stroke();

      // Препятствия / укрытия
      for (const obs of OBSTACLES) {
        ctx.fillStyle = "rgba(0, 0, 0, 0.45)";
        ctx.fillRect(obs.x + 6, obs.y + 8, obs.w, obs.h);

        ctx.fillStyle = obs.color;
        ctx.strokeStyle = obs.accent;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.roundRect(obs.x, obs.y, obs.w, obs.h, 8);
        ctx.fill();
        ctx.stroke();
      }

      // Снаряды
      for (const b of state.bullets) {
        ctx.save();
        ctx.fillStyle = b.color;
        ctx.shadowColor = b.color;
        ctx.shadowBlur = 10;
        ctx.beginPath();
        ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      // Боты
      for (const bot of state.bots) {
        drawFighter(bot, false, true);
      }

      // Онлайн-игроки
      for (const rp of state.remotePlayers.values()) {
        drawFighter(rp, false, false);
      }

      // Наш игрок
      if (state.screen === "playing" || state.screen === "victory") {
        drawFighter({ ...state.me, name: state.myName }, true, false);
      }

      // Частицы
      for (const p of state.particles) {
        const a = Math.max(0, p.life / p.maxLife);
        ctx.save();
        ctx.globalAlpha = a;
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r * a + 0.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      // Всплывающие цифры урона
      for (const ft of state.floatingTexts) {
        const a = Math.max(0, ft.life / ft.maxLife);
        ctx.save();
        ctx.globalAlpha = a;
        ctx.font = "900 14px Inter, sans-serif";
        ctx.textAlign = "center";
        ctx.fillStyle = "#060913";
        ctx.fillText(ft.text, ft.x + 1, ft.y + 1);
        ctx.fillStyle = ft.color;
        ctx.fillText(ft.text, ft.x, ft.y);
        ctx.restore();
      }

      ctx.restore();
    }

    // =========================================================================
    // 15. ЗАПУСК / ПЕРЕЗАПУСК МАТЧА И АДАПТИВНЫЙ CANVAS
    // =========================================================================
    function resizeCanvas() {
      const rect = document.getElementById("app-shell").getBoundingClientRect();
      state.width = Math.max(320, rect.width);
      state.height = Math.max(460, rect.height);
      state.dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.floor(state.width * state.dpr);
      canvas.height = Math.floor(state.height * state.dpr);
      ctx.setTransform(state.dpr, 0, 0, state.dpr, 0, 0);
    }

    window.addEventListener("resize", resizeCanvas);

    async function joinMatch() {
      sound.ensure();
      const rawNick = ui.inputNickname.value.trim();
      state.myName = rawNick || `Боец_${Math.floor(10 + Math.random() * 89)}`;
      saveNick(state.myName);

      const rawRoom = ui.inputRoom.value.trim().toUpperCase().replace(/[^A-ZА-Я0-9_-]/g, "");
      state.roomCode = rawRoom || "ARENA-1";
      ui.inputRoom.value = state.roomCode;

      if (firebaseReady && currentUser) {
        state.myId = currentUser.uid;
      }

      state.sessionStartMs = Date.now();
      state.processedEventIds.clear();
      state.bullets = [];
      state.particles = [];
      state.floatingTexts = [];
      state.killfeed = [];
      renderKillfeed();

      const sp = pickSafeSpawn();
      state.me.x = sp.x;
      state.me.y = sp.y;
      state.me.hp = 100;
      state.me.tier = 0;
      state.me.kills = 0;
      state.me.deaths = 0;
      state.me.streak = 0;
      state.me.invuln = 1.5;

      state.screen = "playing";
      ui.lobbyScreen.classList.add("hidden");
      ui.victoryScreen.classList.add("hidden");
      ui.hudTop.classList.remove("hidden");
      if (!state.hintsDismissed) {
        ui.touchHints.classList.remove("hidden");
      }

      rebalanceBots();
      subscribeToRoom();
      await syncMyStateToCloud(true);
      updateHUD();
      showToast("БОЙ НАЧАЛСЯ", `Комната: ${state.roomCode}`);
    }

    async function leaveToLobby() {
      cleanupRoomSubscriptions();
      await removeMyPlayerDoc();
      clearTouchControls();
      state.remotePlayers.clear();
      state.bots = [];
      state.screen = "lobby";
      ui.hudTop.classList.add("hidden");
      ui.touchHints.classList.add("hidden");
      ui.victoryScreen.classList.add("hidden");
      ui.lobbyScreen.classList.remove("hidden");
    }

    function gameLoop(ts) {
      if (!state.lastTime) state.lastTime = ts;
      const dt = Math.min(0.05, Math.max(0, (ts - state.lastTime) / 1000));
      state.lastTime = ts;

      if (state.screen === "playing") {
        updateSimulation(dt);
      }
      renderScene();
      requestAnimationFrame(gameLoop);
    }

    // Привязка кнопок интерфейса
    ui.btnPlay.addEventListener("click", joinMatch);
    ui.btnRematch.addEventListener("click", joinMatch);
    ui.btnVictoryLobby.addEventListener("click", leaveToLobby);
    ui.btnLeave.addEventListener("click", leaveToLobby);

    ui.btnRandomRoom.addEventListener("click", () => {
      const code = "ARENA-" + Math.floor(10 + Math.random() * 89);
      ui.inputRoom.value = code;
    });

    ui.btnCopyRoom.addEventListener("click", () => {
      const temp = document.createElement("textarea");
      temp.value = state.roomCode;
      document.body.appendChild(temp);
      temp.select();
      try {
        document.execCommand("copy");
        showToast("СКОПИРОВАНО", `Код комнаты: ${state.roomCode}`);
      } catch (_) {}
      document.body.removeChild(temp);
    });

    ui.btnAutofire.addEventListener("click", () => {
      state.autoFire = !state.autoFire;
      ui.autofireLabel.textContent = state.autoFire ? "ВКЛ" : "ВЫКЛ";
      ui.autofireLabel.className = state.autoFire ? "text-emerald-400" : "text-slate-400";
    });

    function syncSoundIcons() {
      ui.iconSoundOn.classList.toggle("hidden", sound.muted);
      ui.iconSoundOff.classList.toggle("hidden", !sound.muted);
    }

    ui.btnMute.addEventListener("click", () => {
      sound.setMuted(!sound.muted);
      syncSoundIcons();
      if (!sound.muted) sound.ensure();
    });

    window.addEventListener("beforeunload", () => {
      removeMyPlayerDoc();
    });

    window.addEventListener("load", () => {
      syncSoundIcons();
      resizeCanvas();
      rebalanceBots();
      state.lastTime = performance.now();
      requestAnimationFrame(gameLoop);
    });
  </script>
