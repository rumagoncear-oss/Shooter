    class SoundEngine {
      constructor() {
        this.ctx = null;
        this.muted = false;
        try {
          if (localStorage.getItem("arena_ru_muted") === "true") {
            this.muted = true;
          }
        } catch (_) {}
      }

      ensure() {
        if (this.muted) return null;
        if (!this.ctx) {
          const AC = window.AudioContext || window.webkitAudioContext;
          if (AC) this.ctx = new AC();
        }
        if (this.ctx && this.ctx.state === "suspended") {
          this.ctx.resume().catch(() => {});
        }
        return this.ctx;
      }

      setMuted(val) {
        this.muted = val;
        try {
          localStorage.setItem("arena_ru_muted", String(val));
        } catch (_) {}
      }

      playWeapon(tier) {
        const ctx = this.ensure();
        if (!ctx) return;
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        const presets = [
          { type: "triangle", f1: 660, f2: 180, dur: 0.08, vol: 0.1 },
          { type: "sawtooth", f1: 780, f2: 240, dur: 0.06, vol: 0.08 },
          { type: "square", f1: 290, f2: 75, dur: 0.14, vol: 0.12 },
          { type: "sawtooth", f1: 540, f2: 140, dur: 0.09, vol: 0.09 },
          { type: "sawtooth", f1: 1350, f2: 120, dur: 0.19, vol: 0.14 },
          { type: "sine", f1: 980, f2: 340, dur: 0.11, vol: 0.11 },
          { type: "square", f1: 190, f2: 48, dur: 0.24, vol: 0.15 },
          { type: "triangle", f1: 1120, f2: 420, dur: 0.09, vol: 0.12 }
        ];

        const p = presets[tier % presets.length];
        osc.type = p.type;
        osc.frequency.setValueAtTime(p.f1 * (0.95 + Math.random() * 0.1), now);
        osc.frequency.exponentialRampToValueAtTime(Math.max(35, p.f2), now + p.dur);

        gain.gain.setValueAtTime(p.vol, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + p.dur);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + p.dur);
      }

      playHit(kill = false) {
        const ctx = this.ensure();
        if (!ctx) return;
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        osc.type = kill ? "sawtooth" : "triangle";
        osc.frequency.setValueAtTime(kill ? 250 : 460, now);
        osc.frequency.exponentialRampToValueAtTime(kill ? 55 : 180, now + (kill ? 0.18 : 0.05));

        gain.gain.setValueAtTime(kill ? 0.14 : 0.06, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + (kill ? 0.18 : 0.05));

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + (kill ? 0.18 : 0.05));
      }

      playRankUp() {
        const ctx = this.ensure();
        if (!ctx) return;
        [440, 554.37, 659.25, 880].forEach((freq, i) => {
          const now = ctx.currentTime + i * 0.055;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = "triangle";
          osc.frequency.setValueAtTime(freq, now);
          gain.gain.setValueAtTime(0.11, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.15);
        });
      }

      playHurt() {
        const ctx = this.ensure();
        if (!ctx) return;
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sawtooth";
        osc.frequency.setValueAtTime(140, now);
        osc.frequency.linearRampToValueAtTime(52, now + 0.2);
        gain.gain.setValueAtTime(0.16, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.2);
      }
    }

