    function subscribeToRoom() {
      cleanupRoomSubscriptions();
      if (!firebaseReady || !currentUser) return;

      // 1. Подписка на игроков в комнате
      state.unsubPlayers = onSnapshot(
        getRoomPlayersCol(),
        (snapshot) => {
          const now = Date.now();
          const activeIds = new Set();

          snapshot.forEach((docSnap) => {
            const data = docSnap.data();
            if (!data || !data.id || data.id === state.myId) return;
            // Игнорируем неактивных игроков (> 15 секунд без пинга)
            if (now - (data.updatedAt || 0) > 15000) return;

            activeIds.add(data.id);
            const existing = state.remotePlayers.get(data.id);
            if (existing) {
              existing.targetX = data.x ?? existing.x;
              existing.targetY = data.y ?? existing.y;
              existing.targetAngle = data.angle ?? existing.angle;
              existing.hp = data.hp ?? 100;
              existing.tier = data.tier ?? 0;
              existing.kills = data.kills ?? 0;
              existing.name = data.name || "Игрок";
              existing.updatedAt = data.updatedAt || now;
            } else {
              state.remotePlayers.set(data.id, {
                id: data.id,
                name: data.name || "Игрок",
                x: data.x ?? 800,
                y: data.y ?? 550,
                targetX: data.x ?? 800,
                targetY: data.y ?? 550,
                angle: data.angle ?? 0,
                targetAngle: data.angle ?? 0,
                radius: 18,
                hp: data.hp ?? 100,
                maxHp: 100,
                tier: data.tier ?? 0,
                kills: data.kills ?? 0,
                updatedAt: data.updatedAt || now,
                hitFlash: 0
              });
              addKillfeedMessage("Система", `${data.name || "Игрок"} вошёл на арену`, "ОНЛАЙН");
            }
          });

          for (const id of state.remotePlayers.keys()) {
            if (!activeIds.has(id)) {
              state.remotePlayers.delete(id);
            }
          }

          rebalanceBots();
          updateHUD();
        },
        (err) => {
          console.warn("Ошибка синхронизации игроков:", err);
        }
      );

      // 2. Подписка на события (выстрелы, попадания, убийства, победа)
      state.unsubEvents = onSnapshot(
        getRoomEventsCol(),
        (snapshot) => {
          snapshot.docChanges().forEach((change) => {
            if (change.type !== "added") return;
            const id = change.doc.id;
            if (state.processedEventIds.has(id)) return;
            state.processedEventIds.add(id);

            const ev = change.doc.data();
            if (!ev || (ev.createdAt || 0) < state.sessionStartMs - 1500) return;

            if (ev.type === "shoot" && ev.senderId !== state.myId) {
              spawnWeaponProjectiles(
                ev.x,
                ev.y,
                ev.angle,
                ev.tier || 0,
                ev.senderId,
                ev.senderName || "Игрок",
                false
              );
            } else if (ev.type === "hit" && ev.targetId === state.myId && state.screen === "playing") {
              applyDamageToMe(ev.damage || 15, ev.senderId, ev.senderName || "Противник", ev.tier || 0);
            } else if (ev.type === "kill") {
              if (ev.senderId !== state.myId) {
                addKillfeedMessage(ev.senderName || "Игрок", ev.victimName || "Цель", WEAPONS[ev.tier || 0].name, ev.tier === 7);
              }
            } else if (ev.type === "win" && state.screen === "playing") {
              triggerMatchVictory(ev.winnerName || "Победитель");
            }
          });
        },
        (err) => {
          console.warn("Ошибка событий комнаты:", err);
        }
      );
    }

