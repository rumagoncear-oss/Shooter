<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>ОНЛАЙН АРЕНА: ГОНКА ВООРУЖЕНИЙ</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      -webkit-user-select: none;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #060913;
      color: #f8fafc;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      touch-action: none;
    }

    #app-shell {
      position: relative;
      width: 100vw;
      height: 100dvh;
      overflow: hidden;
      background: radial-gradient(circle at 50% 50%, #0f172a 0%, #060913 85%);
    }

    #game-canvas {
      display: block;
      width: 100%;
      height: 100%;
      touch-action: none;
      cursor: crosshair;
    }

    .arcade-btn {
      transition: transform 0.1s ease, box-shadow 0.15s ease, background-color 0.15s ease;
      box-shadow: 0 4px 0 rgba(15, 23, 42, 0.9), 0 8px 20px rgba(0, 0, 0, 0.45);
    }

    .arcade-btn:active {
      transform: translateY(2px);
      box-shadow: 0 1px 0 rgba(15, 23, 42, 0.9), 0 3px 10px rgba(0, 0, 0, 0.4);
    }

    @keyframes tierPop {
      0% { transform: translate(-50%, 10px) scale(0.85); opacity: 0; }
      16% { transform: translate(-50%, 0px) scale(1.04); opacity: 1; }
      84% { transform: translate(-50%, 0px) scale(1); opacity: 1; }
      100% { transform: translate(-50%, -8px) scale(0.96); opacity: 0; }
    }

    .tier-banner-anim {
      animation: tierPop 1.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .joystick-base {
      position: absolute;
      width: 122px;
      height: 122px;
      border-radius: 9999px;
      background: rgba(15, 23, 42, 0.45);
      border: 2px solid rgba(148, 163, 184, 0.28);
      backdrop-filter: blur(6px);
      pointer-events: none;
      transform: translate(-50%, -50%);
      z-index: 25;
    }

    .joystick-knob {
      position: absolute;
      width: 50px;
      height: 50px;
      border-radius: 9999px;
      background: radial-gradient(circle at 35% 30%, #38bdf8, #0284c7);
      border: 2px solid rgba(224, 242, 254, 0.75);
      box-shadow: 0 4px 14px rgba(2, 132, 199, 0.55);
      pointer-events: none;
      transform: translate(-50%, -50%);
      z-index: 26;
    }

    .joystick-knob.aim-knob {
      background: radial-gradient(circle at 35% 30%, #fb7185, #e11d48);
      border-color: rgba(255, 228, 230, 0.8);
      box-shadow: 0 4px 14px rgba(225, 29, 72, 0.55);
    }

    /* Allow typing in inputs */
    input {
      user-select: text;
      -webkit-user-select: text;
    }
  </style>
</head>
<body>
  <div id="app-shell">
    <canvas id="game-canvas"></canvas>

    <!-- Верхний HUD во время боя -->
    <header id="hud-top" class="hidden pointer-events-none absolute top-0 left-0 right-0 z-30 p-2.5 sm:p-4 flex items-start justify-between gap-2">
      <!-- Левый блок: Здоровье, Серия, Комната и Онлайн -->
      <div class="flex flex-col gap-1.5 min-w-[145px] sm:min-w-[205px]">
        <div class="bg-slate-900/85 backdrop-blur-md border border-slate-700/70 rounded-xl px-3 py-2 shadow-lg">
          <div class="flex items-center justify-between text-[11px] font-bold tracking-wider uppercase text-slate-300 mb-1">
            <span>БРОНЯ</span>
            <span id="hud-hp-text" class="text-emerald-400">100</span>
          </div>
          <div class="w-full h-2.5 bg-slate-800 rounded-full overflow-hidden">
            <div id="hud-hp-bar" class="h-full bg-gradient-to-r from-emerald-500 to-teal-400 rounded-full transition-all duration-150" style="width: 100%;"></div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-1.5 pointer-events-auto">
          <button id="btn-copy-room" type="button" title="Скопировать код комнаты" class="arcade-btn bg-slate-900/85 hover:bg-slate-800 border border-slate-700/80 rounded-lg px-2.5 py-1 text-[11px] font-extrabold text-cyan-300 flex items-center gap-1.5 cursor-pointer">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>КОМНАТА: <span id="hud-room-code" class="text-white">ARENA-1</span></span>
          </button>

          <div class="bg-slate-900/85 border border-slate-700/80 rounded-lg px-2 py-1 text-[11px] font-bold text-slate-300">
            ОНЛАЙН: <span id="hud-online-count" class="text-emerald-400 font-black">1</span>
          </div>

          <div id="hud-streak" class="hidden bg-rose-500/20 border border-rose-400/50 rounded-lg px-2 py-1 text-[11px] font-black text-rose-300">
            СЕРИЯ x<span id="hud-streak-val">2</span>
          </div>
        </div>
      </div>

      <!-- Центр: Текущий ранг оружия (Гонка вооружений) -->
      <div class="flex flex-col items-center bg-slate-900/90 backdrop-blur-md border border-cyan-500/40 rounded-2xl px-3.5 py-2 shadow-xl max-w-[200px] sm:max-w-[260px] w-full">
        <div class="flex items-center justify-between w-full gap-1 text-[10px] sm:text-xs font-extrabold uppercase tracking-wider">
          <span class="text-cyan-400">РАНГ <span id="hud-tier-num">1</span>/<span id="hud-tier-max">8</span></span>
          <span id="hud-weapon-name" class="text-white truncate">ПИСТОЛЕТ</span>
        </div>
        <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden mt-1.5">
          <div id="hud-tier-bar" class="h-full bg-gradient-to-r from-cyan-400 via-sky-400 to-amber-400 rounded-full transition-all duration-150" style="width: 12.5%;"></div>
        </div>
        <div id="hud-tier-hint" class="text-[10px] text-slate-400 mt-1 font-semibold truncate max-w-full">
          Убейте врага для след. оружия
        </div>
      </div>

      <!-- Правый блок: Кнопки управления, Таблица лидеров и Килл-фид -->
      <div class="flex flex-col items-end gap-1.5">
        <div class="flex items-center gap-1.5 pointer-events-auto">
          <button id="btn-autofire" type="button" title="Авто-огонь (ПК)" class="arcade-btn px-2.5 h-9 rounded-xl bg-slate-800/90 hover:bg-slate-700 border border-slate-600/70 text-[11px] font-extrabold text-slate-300 cursor-pointer">
            АВТО: <span id="autofire-label" class="text-slate-400">ВЫКЛ</span>
          </button>

          <button id="btn-mute" type="button" aria-label="Звук" class="arcade-btn w-9 h-9 rounded-xl bg-slate-800/90 hover:bg-slate-700 border border-slate-600/70 flex items-center justify-center text-slate-200 cursor-pointer">
            <svg id="icon-sound-on" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5L6 9H2v6h4l5 4V5z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.54 8.46a5 5 0 010 7.07M19.07 4.93a10 10 0 010 14.14" />
            </svg>
            <svg id="icon-sound-off" class="w-4 h-4 hidden text-rose-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5L6 9H2v6h4l5 4V5z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M23 9l-6 6M17 9l6 6" />
            </svg>
          </button>

          <button id="btn-leave" type="button" title="Выйти в лобби" class="arcade-btn w-9 h-9 rounded-xl bg-slate-800/90 hover:bg-rose-900/80 border border-slate-600/70 flex items-center justify-center text-slate-200 cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
          </button>
        </div>

        <!-- Мини-таблица лидеров -->
        <div class="hidden sm:block bg-slate-900/80 backdrop-blur-md border border-slate-700/70 rounded-xl p-2.5 w-52 shadow-lg">
          <div class="text-[10px] font-black uppercase tracking-wider text-slate-400 mb-1.5 flex justify-between">
            <span>ЛИДЕРЫ АРЕНЫ</span>
            <span>РАНГ</span>
          </div>
          <div id="leaderboard-list" class="flex flex-col gap-1 text-xs"></div>
        </div>

        <!-- Килл-фид (лента убийств) -->
        <div id="killfeed-list" class="flex flex-col items-end gap-1 mt-0.5 max-w-[240px]"></div>
      </div>
    </header>

    <!-- Тост-уведомление (копирование кода, новое оружие, серия) -->
    <div id="toast-banner" class="hidden pointer-events-none fixed top-24 left-1/2 z-40 bg-gradient-to-r from-cyan-600/95 via-sky-600/95 to-indigo-600/95 border border-cyan-300/60 text-white px-4 py-2 rounded-2xl shadow-2xl text-center whitespace-nowrap">
      <div id="toast-subtitle" class="text-[10px] font-black uppercase tracking-widest text-cyan-100">НОВОЕ ОРУЖИЕ</div>
      <div id="toast-title" class="text-sm sm:text-base font-extrabold tracking-wide">ПП-19 ВИТЯЗЬ</div>
    </div>

    <!-- Подсказки для сенсорного экрана -->
    <div id="touch-hints" class="hidden pointer-events-none fixed bottom-4 left-0 right-0 z-20 px-4 flex items-end justify-between text-[11px] font-semibold text-slate-400/85">
      <div class="bg-slate-900/60 border border-slate-700/60 rounded-xl px-3 py-2 backdrop-blur-sm">
        Левый палец: <span class="text-sky-300 font-bold">ДВИЖЕНИЕ</span>
      </div>
      <div class="bg-slate-900/60 border border-slate-700/60 rounded-xl px-3 py-2 backdrop-blur-sm text-right">
        Правый палец: <span class="text-rose-300 font-bold">ПРИЦЕЛ И ОГОНЬ</span>
      </div>
    </div>

    <!-- Виртуальные джойстики -->
    <div id="move-stick-base" class="joystick-base hidden"></div>
    <div id="move-stick-knob" class="joystick-knob hidden"></div>
    <div id="aim-stick-base" class="joystick-base hidden"></div>
    <div id="aim-stick-knob" class="joystick-knob aim-knob hidden"></div>

    <!-- Стартовый экран / Лобби -->
    <section id="lobby-screen" class="fixed inset-0 z-40 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-md overflow-y-auto">
      <div class="w-full max-w-lg bg-slate-900/95 border border-slate-700/80 rounded-3xl p-5 sm:p-7 shadow-2xl my-auto">
        <div class="flex items-center justify-between gap-2 mb-2">
          <span id="network-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-cyan-500/15 text-cyan-300 border border-cyan-400/30">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
            ПОДКЛЮЧЕНИЕ К СЕТИ...
          </span>
          <span class="text-xs font-bold text-amber-400">
            ПОБЕД: <span id="lobby-wins">0</span>
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white leading-tight">
          ОНЛАЙН АРЕНА: <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-400 to-amber-400">ГОНКА ВООРУЖЕНИЙ</span>
        </h1>
        <p class="text-xs sm:text-sm text-slate-300 mt-1.5 leading-relaxed">
          Сражайтесь с реальными игроками онлайн и умными ботами. Каждое убийство повышает ранг оружия от <strong class="text-white">Пистолета</strong> до <strong class="text-amber-300">Золотого Ножа</strong>!
        </p>

        <!-- Настройки игрока и комнаты -->
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="input-nickname" class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Ваш позывной</label>
            <input id="input-nickname" type="text" maxlength="16" placeholder="Боец_77" class="w-full bg-slate-950/90 border border-slate-700 focus:border-cyan-400 rounded-xl px-3.5 py-2.5 text-sm font-bold text-white outline-none transition" />
          </div>
          <div>
            <label for="input-room" class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Код комнаты (для друзей)</label>
            <div class="flex gap-1.5">
              <input id="input-room" type="text" maxlength="14" value="ARENA-1" placeholder="ARENA-1" class="w-full bg-slate-950/90 border border-slate-700 focus:border-cyan-400 rounded-xl px-3.5 py-2.5 text-sm font-extrabold uppercase text-cyan-300 outline-none transition" />
              <button id="btn-random-room" type="button" title="Случайная комната" class="arcade-btn px-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-bold text-xs cursor-pointer">
                🎲
              </button>
            </div>
          </div>
        </div>

        <!-- Лестница из 8 видов оружия -->
        <div class="mt-4 bg-slate-950/80 border border-slate-800 rounded-2xl p-3">
          <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">Арсенал гонки вооружений (8 рангов)</div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 text-[11px] font-bold">
            <div class="bg-slate-900 border border-slate-800 rounded-lg px-2 py-1 text-slate-200">1. Пистолет</div>
            <div class="bg-slate-900 border border-slate-800 rounded-lg px-2 py-1 text-sky-300">2. ПП-19</div>
            <div class="bg-slate-900 border border-slate-800 rounded-lg px-2 py-1 text-orange-300">3. Дробовик</div>
            <div class="bg-slate-900 border border-slate-800 rounded-lg px-2 py-1 text-emerald-300">4. Автомат АК</div>
            <div class="bg-slate-900 border border-slate-800 rounded-lg px-2 py-1 text-indigo-300">5. Снайперка</div>
            <div class="bg-slate-900 border border-slate-800 rounded-lg px-2 py-1 text-purple-300">6. Плазмоган</div>
            <div class="bg-slate-900 border border-slate-800 rounded-lg px-2 py-1 text-rose-300">7. Ракетомет</div>
            <div class="bg-amber-500/15 border border-amber-400/40 rounded-lg px-2 py-1 text-amber-300">8. Золотой Нож</div>
          </div>
        </div>

        <!-- Управление -->
        <div class="mt-3 grid grid-cols-2 gap-2 text-[11px] text-slate-300">
          <div class="bg-slate-800/50 border border-slate-700/60 rounded-xl p-2.5">
            <span class="font-extrabold text-sky-300 block">Телефон / Планшет:</span>
            Левый джойстик — бег, правый — прицел и стрельба.
          </div>
          <div class="bg-slate-800/50 border border-slate-700/60 rounded-xl p-2.5">
            <span class="font-extrabold text-rose-300 block">Компьютер (ПК):</span>
            WASD / Стрелки — бег, Мышь — прицел и огонь.
          </div>
        </div>

        <button id="btn-play" type="button" class="arcade-btn mt-5 w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-cyan-500 via-sky-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-black text-base tracking-wide uppercase cursor-pointer">
          В БОЙ!
        </button>
      </div>
    </section>

    <!-- Экран победы в матче -->
    <section id="victory-screen" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-md">
      <div class="w-full max-w-md bg-slate-900/95 border border-amber-400/50 rounded-3xl p-6 text-center shadow-2xl">
        <div class="inline-block px-3 py-1 rounded-full text-xs font-black uppercase tracking-widest bg-amber-400/20 text-amber-300 border border-amber-400/40 mb-2">
          МАТЧ ЗАВЕРШЁН
        </div>
        <h2 id="victory-winner-name" class="text-2xl sm:text-3xl font-black text-white tracking-tight">
          ПОБЕДИТЕЛЬ: БОЕЦ
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-1">
          Финальный удар <span class="text-amber-300 font-bold">Золотым Ножом</span> завершил гонку вооружений!
        </p>

        <div id="victory-scoreboard" class="mt-4 bg-slate-950/80 border border-slate-800 rounded-2xl p-3 text-left flex flex-col gap-1.5 max-h-48 overflow-y-auto"></div>

        <div class="mt-5 flex flex-col sm:flex-row gap-2.5">
          <button id="btn-rematch" type="button" class="arcade-btn flex-1 py-3.5 px-5 rounded-2xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-black text-sm uppercase tracking-wider cursor-pointer">
            Сыграть ещё раз
          </button>
          <button id="btn-victory-lobby" type="button" class="arcade-btn py-3.5 px-5 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-sm uppercase tracking-wider border border-slate-700 cursor-pointer">
            В лобби
          </button>
        </div>
      </div>
    </section>
  </div>

  <!-- Firebase SDK + Основная логика игры -->
